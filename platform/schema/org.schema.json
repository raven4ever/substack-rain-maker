{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raven4ever/substack-rain-maker/platform/schema/org.schema.json",
  "title": "orgs/<org>/org.yaml",
  "description": "Shape only. Every value allowlist lives in platform/guardrails.yaml and is checked by scripts/validate.py, so there is one source of truth per concern (ADR 0010).",
  "type": "object",
  "additionalProperties": false,
  "required": ["organization", "teams"],
  "properties": {
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "atlas_org_id"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}$" },
        "atlas_org_id": { "type": "string" }
      }
    },
    "teams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "org_roles"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$" },
          "org_roles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "members": {
            "type": "array",
            "items": { "type": "string", "format": "email", "pattern": "^[^@\\s]+@[^@\\s]+$" }
          }
        }
      }
    }
  }
}
