{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raven4ever/substack-rain-maker/platform/schema/environment.schema.json",
  "title": "orgs/<org>/<env>/environment.yaml",
  "description": "Shape only. Every value allowlist lives in platform/guardrails.yaml and is checked by scripts/validate.py (ADR 0010).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment",
    "clusters"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,20}$"
    },
    "class": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "description": "The project name is not declarable: the module computes <org>-<env>.",
      "required": [
        "tags"
      ],
      "properties": {
        "tags": {
          "type": "object",
          "required": [
            "owner",
            "cost_center"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "clusters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "oneOf": [
          {
            "title": "template path",
            "additionalProperties": false,
            "required": [
              "template"
            ],
            "properties": {
              "template": {
                "type": "string"
              },
              "overrides": {
                "type": "object"
              },
              "online_archive": {
                "$ref": "#/$defs/online_archive"
              },
              "regions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "priority"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "node_count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "priority": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 7
                    }
                  }
                }
              }
            }
          },
          {
            "title": "custom path",
            "additionalProperties": false,
            "required": [
              "cluster_type",
              "cloud_provider",
              "instance_size"
            ],
            "properties": {
              "cluster_type": {
                "type": "string"
              },
              "cloud_provider": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "instance_size": {
                "type": "string"
              },
              "node_count": {
                "type": "integer",
                "minimum": 3
              },
              "disk_size_gb": {
                "type": "integer",
                "minimum": 10
              },
              "mongodb_major_version": {
                "type": "string"
              },
              "backup_enabled": {
                "type": "boolean"
              },
              "termination_protection": {
                "type": "boolean"
              },
              "online_archive": {
                "$ref": "#/$defs/online_archive"
              },
              "regions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "priority"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "node_count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "priority": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 7
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "database_users": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aws_iam_role_arn",
          "roles"
        ],
        "properties": {
          "aws_iam_role_arn": {
            "type": "string",
            "pattern": "^arn:aws:iam::[0-9]{12}:role/.+$"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "database",
                "role"
              ],
              "properties": {
                "database": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "network_access": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cidr",
          "comment"
        ],
        "properties": {
          "cidr": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
          },
          "comment": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "team_access": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "team",
          "project_roles"
        ],
        "properties": {
          "team": {
            "type": "string"
          },
          "project_roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sql_interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "source_cluster"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "source_cluster": {
          "type": "string"
        },
        "databases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "collections"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "collections": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "private_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "regions"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "aws_vpc_endpoint_id": {
                "type": "string",
                "pattern": "^vpce-[0-9a-f]+$"
              }
            }
          }
        },
        "data_federation_vpc_endpoint_id": {
          "type": "string",
          "pattern": "^vpce-[0-9a-f]+$"
        }
      }
    }
  },
  "$defs": {
    "online_archive": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "database",
          "collection",
          "date_field"
        ],
        "properties": {
          "database": {
            "type": "string"
          },
          "collection": {
            "type": "string"
          },
          "date_field": {
            "type": "string"
          },
          "expire_after_days": {
            "type": "integer",
            "minimum": 1
          },
          "partition_fields": {
            "type": "array",
            "description": "Extra partition fields. The date_field is added first automatically.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
